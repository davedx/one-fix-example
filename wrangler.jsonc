{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "one-fix-example",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "one-fix-example",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "EMAIL_FROM": "One Fix <sender@example.com>"
  }
}
